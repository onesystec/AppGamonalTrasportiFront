    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "check:i18n": "node scripts/check-i18n.mjs",
    "preview": "vite preview",
    "build:mobile": "VITE_API_URL=https://appgamonaltrasportiback-vv19.onrender.com/api vite build && npx cap sync android && npx cap sync ios",
